# Copy to .env and adjust. All values have working defaults for local dev.

# --- Management system (HQ) ---
HR_DB_PATH=data/hr.db
HR_TIMEZONE=Asia/Jakarta
HR_EXPORT_DIR=data/exports

# API keys the ingest endpoint will accept from site agents.
# Comma-separated. Each site agent is issued one. Empty = reject all ingest
# (the mock tool and tests set this explicitly).
HR_INGEST_API_KEYS=dev-local-key

# Coding thresholds (hours). Per-shift overrides live in config/shifts.yaml;
# these are the fallback defaults.
HR_SHORT_SHIFT_HOURS=6.0
HR_LONG_SHIFT_HOURS=16.0

# Punches on the same reader within this many seconds are treated as one event.
HR_CHATTER_WINDOW_SECONDS=90

# --- Site agent (Phase 4) ---
AGENT_ID=site-01
AGENT_DEVICE_IP=192.168.1.201
AGENT_DEVICE_PORT=4370
AGENT_HQ_URL=http://localhost:8000
AGENT_HQ_API_KEY=dev-local-key
AGENT_SPOOL_PATH=agent/spool.db
AGENT_POLL_SECONDS=300
